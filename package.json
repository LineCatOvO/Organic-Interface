{
  "name": "organic-interface",
  "version": "0.1.0",
  "private": true,
  "description": "Organic Interface - Plugin-based Agent Framework",
  "type": "module",
  "bin": {
    "organic-interface": "./packages/ui/dist/cli.js"
  },
  "scripts": {
    "//build-warning": "⚠️ 宿主机直接运行，推荐使用 dev:docker 在 Docker 沙箱中构建和运行",
    "build": "turbo run build",
    "//dev-warning": "⚠️ 宿主机直接运行，推荐使用 dev:docker 在 Docker 沙箱中运行",
    "dev": "turbo run dev",
    "dev:docker": "docker compose -f docker-compose.dev.yml --profile dev up --build",
    "//test-warning": "⚠️ 宿主机直接运行测试，推荐使用 test:docker 在 Docker 沙箱中运行",
    "test": "vitest run",
    "test:docker": "docker compose -f docker-compose.dev.yml --profile test up --build",
    "//test:watch-warning": "⚠️ 宿主机直接运行，推荐使用 test:docker 在 Docker 沙箱中运行",
    "test:watch": "vitest",
    "//test:coverage-warning": "⚠️ 宿主机直接运行，推荐使用 test:docker 在 Docker 沙箱中运行",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "typecheck": "turbo run typecheck",
    "docs": "typedoc",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "turbo": "^2.9.16",
    "typedoc": "^0.28.19",
    "typescript": "^5.4.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.28.1"
}
